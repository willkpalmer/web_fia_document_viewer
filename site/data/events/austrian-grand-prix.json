   "title": "Doc 34 - Decision - Qualifying SC2-SC1 Times",
   "subject": "Decision - Qualifying SC2-SC1 Times",
   "category": "stewards",
   "url": "https://www.fia.com/system/files/decision-document/2026_austrian_grand_prix_-_decision_-_qualifying_sc2-sc1_times.pdf",
